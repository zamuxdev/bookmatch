# BACKEND ONLY. Copy to .env; Docker Compose injects these into Functions only.
TMDB_API_KEY=your_tmdb_v3_api_key
AI_API_KEY=your_ai_api_key
AI_API_URL=https://your-provider.example/v1/chat/completions
AI_MODEL=your_model
# Optional, for Google Books quota
GOOGLE_BOOKS_API_KEY=
# Mercado Pago Checkout Pro sandbox. Use a TEST- access token; never commit real values.
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_test_access_token
APP_BASE_URL=http://localhost:5173
